<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head.ejs") %>

  <body>
    <%- include("partials/navbar.ejs") %>

    <main>
      <section class="admin-container">

        <div class="page-header">
          <h2>Upload Notes</h2>
          <p>Add new study materials for students.</p>
        </div>

        <div class="form-card">
          <form action="/admin" method="post" enctype="multipart/form-data">

            <div class="form-group">
              <label for="title">Title</label>
              <input
                type="text"
                name="title"
                id="title"
                required
              />
            </div>

            <div class="form-group">
              <label for="semester">Semester</label>
              <input
                type="number"
                name="semester"
                id="semester"
                min="1"
                max="6"
                required
              />
            </div>

            <div class="form-group">
              <label for="subject">Subject</label>
              <input
                type="text"
                name="subject"
                id="subject"
                placeholder="Enter subject name"
                required
              />
            </div>

            <div class="form-group">
              <label for="unit">Unit</label>
              <input
                type="number"
                name="unit"
                id="unit"
                min="1"
                required
              />
            </div>

            <div class="form-group">
              <label for="pdf">PDF</label>
              <input
                type="file"
                name="pdf"
                id="pdf"
                accept=".pdf"
                required
              />
            </div>

            <button type="submit" class="btn btn-browse btn-submit">
              Upload Note
            </button>

          </form>
        </div>

      </section>
    </main>

  </body>
</html>