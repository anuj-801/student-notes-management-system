<!DOCTYPE html>
<html lang="en">
<%- include("partials/head.ejs") %>

    <body>
        <nav>
      <a href="/" class="logo">STUDENTNOTES</a>
      <ul class="nav-links">
        <li><a href="/admin" class="btn btn-primary">DASHBOARD</a></li>
      </ul>
    </nav>
            <main>
                <section class="admin-container">
                    <div class="page-header">
                        <h2>Manage Notes</h2>
                        <p>View and manage uploaded study materials.</p>
                    </div>
                    <div class="admin-notes-list">

                        <% for (const note of notes) { %>

                            <div class="admin-note-row">

                                <div class="admin-note-info">
                                    <h3>
                                        <%= note.title %>
                                    </h3>

                                    <p>
                                        Semester <%= note.semester %>
                                            ·
                                            <%= note.subject %>
                                                ·
                                                Unit <%= note.unit %>
                                    </p>
                                </div>

                                <div class="admin-note-actions">

                                    <a href="<%= note.pdf %>" target="_blank" class="btn btn-browse">
                                        View PDF
                                    </a>

                                    <a href="/admin/notes/edit/<%=note._id%>" class="btn btn-edit">Edit</a>

                                    <form action="/admin/notes/delete/<%= note._id %>?_method=DELETE" method="POST"
                                        onsubmit="return confirm('Are you sure you want to delete this note?');">
                                        <button type="submit" class="btn btn-delete">
                                            Delete
                                        </button>
                                    </form>

                                </div>

                            </div>

                            <% } %>

                    </div>
                </section>
            </main>

    </body>

</html>