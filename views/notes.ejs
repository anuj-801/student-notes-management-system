<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Notes Management System</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body>
    <nav>
      <a href="/" class="logo">
        Student <span class="text-style">Notes</span>
      </a>
      <ul class="nav-links">
        <li><a href="/about">About</a></li>
        <li><a href="/notes" class="btn btn-outline"> Explore Notes </a></li>
        <li><a href="/login" class="btn btn-primary"> Login </a></li>
      </ul>
    </nav>
    <main>
      <section class="page-container">
        <div class="page-header">
          <h2>Select Your Semester</h2>
          <p>
            Choose your current semester to find study materials, notes, and
            previous papers.
          </p>
        </div>
        <div class="card-container">
          <a href="/notes/semester1" class="card">
            <div class="card-icon">📚</div>
            <h3>Semester 1</h3>
            <p>Browse Subjects</p>
          </a>
          <a href="/notes/semester2" class="card">
            <div class="card-icon">📚</div>
            <h3>Semester 2</h3>
            <p>Browse Subjects</p>
          </a>
          <a href="/notes/semester3" class="card">
            <div class="card-icon">📚</div>
            <h3>Semester 3</h3>
            <p>Browse Subjects</p>
          </a>
          <a href="/notes/semester4" class="card">
            <div class="card-icon">📚</div>
            <h3>Semester 4</h3>
            <p>Browse Subjects</p>
          </a>
          <a href="/notes/semester5" class="card">
            <div class="card-icon">📚</div>
            <h3>Semester 5</h3>
            <p>Browse Subjects</p>
          </a>
          <a href="/notes/semester6" class="card">
            <div class="card-icon">📚</div>
            <h3>Semester 6</h3>
            <p>Browse Subjects</p>
          </a>
        </div>
      </section>
    </main>
  </body>
</html>
