<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head.ejs") %>

  <body>
    <nav>
      <a href="/" class="logo">STUDENTNOTES</a>
      <ul class="nav-links">
        <li><a href="/" class="btn btn-primary">HOME</a></li>
      </ul>
    </nav>

    <main>
      <section class="page-container login-container">
        <div class="form-card">
          <h3>Admin Login</h3>
          <p>Login to manage study materials and upload notes.</p>
          <form action="/login" method="post">
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" name="email" id="email" required />
            </div>
            <div class="form-group">
              <label for="password">Password</label>
              <input type="password" name="password" id="password" required />
            </div>
            <button type="submit" class="btn btn-browse btn-submit">
              Login
            </button>
          </form>
        </div>
      </section>
    </main>
  </body>
</html>
