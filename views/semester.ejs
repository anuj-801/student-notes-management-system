<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Notes Management System</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body>
    <nav>
      <a href="/" class="logo">
        Student <span class="text-style">Notes</span>
      </a>
      <ul class="nav-links">
        <li><a href="/about">About</a></li>
        <li><a href="/notes" class="btn btn-outline"> Explore Notes </a></li>
        <li><a href="/login" class="btn btn-primary"> Login </a></li>
      </ul>
    </nav>
    <main>
      <section class="page-container">
        <div class="page-header">
          <h2>Semester 1 Subjects</h2>
          <p>
            Select a subject to access study materials, notes, and previous year
            papers.
          </p>
        </div>
        <div class="card-container">
          <a href="/notes/semester1/c-programming" class="card">
            <h3>C Programming</h3>
            <p>Browse Notes</p>
          </a>
          <a href="/notes/semester1/cod" class="card">
            <h3>Computerized Documentation Tools </h3>
            <p>Browse Notes</p>
          </a>
          <a href="/notes/semester1/foc" class="card">
            <h3>Fundamentals Of Computer </h3>
            <p>Browse Notes</p>
          </a>
          <a href="/notes/semester1/math" class="card">
            <h3>Advance Mathematics</h3>
            <p>Browse Notes</p>
          </a>
          <a href="/notes/semester1/cs" class="card">
            <h3>Communication Skills -Oral</h3>
            <p>Browse Notes</p>
          </a>
          <a href="/notes/semester1/iks" class="card">
            <h3>Introduction to IKS </h3>
            <p>Browse Notes</p>
          </a>
        </div>
      </section>
    </main>
  </body>
</html>
