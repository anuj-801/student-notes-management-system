<!DOCTYPE html>
<html lang="en">
<%- include("partials/head.ejs") %>

  <body>
    <%- include("partials/navbar.ejs") %>

      <main>
        <section class="page-container">
          <div class="page-header">
            <h2>Semester <%= semester %> Subjects</h2>
            <p>
              Select a subject to access study materials, notes, and previous year
              papers.
            </p>
          </div>
          <div class="card-container">
            <% for (const subject of subjects) { %>
              <a href="/notes/semester/<%= semester %>/<%= subject.toLowerCase().replaceAll(" ", "-") %>" class="card">
                <h3>
                  <%= subject %>
                </h3>
                <p>Browse Notes</p>
              </a>
              <% } %>
          </div>
        </section>
      </main>
      <script src="/js/app.js"></script>
  </body>

</html>